type ReservoirState = "active" | "decaying" | "ignored";
type MemoryMode = "phi" | "delta" | "lambda"; // Φ, Δ, Λ

type ContextBlock = {
  id: string;
  text: string;
  source: "pdf" | "chat" | "manual" | "system";
  createdAt: number;
  lastUsedAt: number | null;
  attention: number; // 0..1
