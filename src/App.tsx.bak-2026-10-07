};

type RecursiveProtocolObject = {
  id: string;
  name: string;
  description: string;
  origin: string;
  created_at: number;
  updated_at: number;
  status: string;
  schema_version: string;
  raw_text?: string | null;
};

type PdfNode = {
  id: string;
